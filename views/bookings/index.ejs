<% layout("/layout/boilerplate") -%>
<body>
   <% for(let booking of bookings) { %>
     <div class="mt-3">
       <h3>Hotel Name :<%= booking.listing.title %></h3>
       <p>Check-in: <%= booking.checkInDate %></p>
       <p>Check-out: <%= booking.checkOutDate %></p>
       <p>Payment Status: <%= booking.paymentStatus %></p>
       <hr>
     </div>
   <% } %>
</body>