<% layout("/layout/boilerplate") -%>

<body>
    <%   if(bookings.length===0){ %>
        <div class="alert alert-danger" role="alert">
          You have no bookings yet. 
        </div>
      <% } %>
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mt-5">
    <% if(bookings.length > 0) { %>
    <h4>All Bookings</h4>
    <% } %>
    <br />
        
    <% for(let booking of bookings) { %>

      <div class="card booking_card">
        <div class="card-body">
          <h5 class="card-title" style="color: #007bff;">
            <%= booking.listing.title %>
          </h5>

          <p class="card-text">
            Check-in: <%= booking.checkInDate.toDateString() %>
          </p>

          <p class="card-text">
            Check-out: <%= booking.checkOutDate.toDateString() %>
          </p>

          <p class="card-text" >
            Payment Status: <span style="color: green; font-weight: bold;"><%= booking.paymentStatus %></span>
          </p>
        </div>
      </div>

    <% } %>
  </div>
</body>