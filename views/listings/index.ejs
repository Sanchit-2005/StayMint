<% layout("/layout/boilerplate") -%>
<body>
  <div id="filters" class="mt-3">
    <!-- <div class="filto">
      <i class="fa-solid fa-filter"></i>
      <p>Filters</p>
    </div> -->
    <div class="filter">
      <a href="/listings">
        <i class="fa-solid fa-fire"></i>
        <p>All</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Trending">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p></a
      >
    </div>

    <div class="filter">
      <a href="/listings?category=Beach"
        ><i class="fa-solid fa-umbrella-beach"></i>
        <p>Beach</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Mountain">
        <i class="fa-solid fa-mountain-sun"></i>
        <p>Mountain</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Surfing"
        ><i class="fa-solid fa-person-skating"></i>
        <p>Surfing</p>
      </a>
    </div>
    <!-- <div class="filter">
      <a href="/listings?category=Iconic Cities"
        ><i class="fa-solid fa-tree-city"></i>
        <p>Iconic Cities</p>
      </a>
    </div> -->
    <div class="filter">
      <a href="/listings?category=OMG"
        ><i class="fa-solid fa-spaghetti-monster-flying"></i>
        <p>OMG</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Bed_Brakfast"
        ><i class="fa-solid fa-mug-hot"></i>
        <p>Bed & Brakfast</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Arctic"
        ><i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Tiny House"
        ><i class="fa-regular fa-house"></i>
        <p>Tiny House</p>
      </a>
    </div>
    
    <div class="filter">
      <a href="/listings?category=Amazing Pool">  <i class="fa-solid fa-person-swimming"></i>
      <p>Amazing Pool</p></a>
    
    </div>
    <div class="filter">
      <a href="/listings?category=Top of world"
        ><i class="fa-solid fa-award"></i>
        <p>Top of world</p>
      </a>
    </div>
    <!-- <div class="filter">
      <i class="bi bi-arrow-right-circle-fill"></i>
      <p>Top of world</p>
    </div> -->
  </div>
  <div
    class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 row-cols-xsm-1 g-4 mt-3"
    id="box"
  >
    <%for(let list of listingInfo) {%>
    <a href="/listings/<%=list._id%>" class="listing-link">
      <div class="card col card-listing">
        <img
          src="<%= list.image.url %>"
          class="card-img-top"
          alt="listing_image"
          style="height: 20rem; object-fit: cover"
        />
        <div class="card-body">
          <p class="card-text">
            <b><%= list.title %> </b>
            <br />
            &#8377;<%= list.price.toLocaleString("en-IN") %>/night
          </p>
        </div>
      </div>
    </a>

    <br />
    <br />
    <br />
    <% } %>
  </div>
</body>
