<% layout("/layout/boilerplate") -%>

<body>
  <div class="row mb-3 mt-3 ">
    <div class="col-8 offset-2">
      <h2 class="offset-1"><%=listedgData.title%></h2>
      <div class="card show-hotel col-8 offset-2">
        <img
          src="<%=listedgData.image.url%>"
          class="card-img-top show-img"
          alt="..."
        />
        <div class="card-body">
          <p class="card-text">
            <p>Owned by <%=listedgData.owner.username %></p>
            <%=listedgData.description %>
            <br />
            <br>
            <p>Spaciality : <b><%=listedgData.category %></b></p>
            <br />
            &#8377;<%= listedgData.price.toLocaleString("en-IN") %>
            <br />
            <%=listedgData.location %>
            <br />
            <%=listedgData.country %>
          </p>
        </div>
        <form action="/listings/book/<%=listedgData.id%>">
             <button class="btn btn-primary">Book Now</button>
        </form>
        
      </div>

      <% if(currUser&&currUser.equals(listedgData.owner)){ %>

      <div class="btns mb-3">
        <form action="/listings/edit/<%=listedgData.id%>" method="GET">
          <button type="submit" class="btn btn-success offset-2">Edit</button>
        </form>
        <br />
        <form
          id="delete-form"
          action="/listings/<%=listedgData.id%>?_method=DELETE"
          method="POST"
        >
          <button type="submit" class="btn btn-danger offset-2">
            Delete this listing
          </button>
        </form>
      </div>
      <% } %>
    </div>
    <hr />

    <% if(currUser) {%>
    <!-- reviews  form  -->
    <div class="col-8 offset-3 mt-5">
      <h4>Write a review</h4>
      <form
        action="/listings/<%=listedgData.id%>/reviews/"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3 mt-3">
       
          <fieldset class="starability-heartbeat">
  <legend>rating:</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>

        </div>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea
            class="form-control"
            id="comment"
            name="review[comment]"
            rows="5"
            placeholder="Write something"
            required
          ></textarea>
          <div class="invalid-feedback">please write something</div>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
      </form>

    
    </div>

 <% } %>


    <!-- showing the reviews -->
    <div class="col-8 offset-3 mt-5">
    <h4>All Reviews</h4>
<br>
    <div class="row">
        <% for(let review of listedgData.reviews){ %>

        <div class="col-6 mb-3">
            <div class="card h-100 review-card">
                <div class="card-body">
                    <h5 class="card-title">@<%=review.reviewAuthor.username %></h5>
                        <br>
                     <p class="starability-result" data-rating="<%=review.rating %>">
                          <p class="card-text">
                        <%= review.comment %> 
                    </p>
    
  </p>
                       <% if(currUser&&currUser.equals(review.reviewAuthor)){ %>
                    <form method="POST" action="/listings/<%=listedgData._id%>/reviews/<%=review._id%>?_method=DELETE">
                         <button class="btn btn-danger" type="submit">Delete Review</button>
                    </form>
                    <% } %>
                    
                </div>
                
            </div>
        </div>

        <% } %>
    </div>
   
</div>

  </div>

  <script>
    // This is an example script, please modify as needed
    const rangeInput = document.getElementById("rating");
    const rangeOutput = document.getElementById("rangeValue");

    // Set initial value
    rangeOutput.textContent = rangeInput.value;

    rangeInput.addEventListener("input", function () {
      rangeOutput.textContent = this.value;
    });

    const deleteForm = document.getElementById("delete-form");

    deleteForm.addEventListener("submit", function (e) {
      e.preventDefault();

      Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to recover this listing!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, delete it!",
      })

        .then((result) => {
          if (result.isConfirmed) {
            deleteForm.submit();
          }
        });
    });
  </script>
</body>
