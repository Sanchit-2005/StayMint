<style>
  #search {
    background-color: #1b4ef5;
    color: white;
  }
  .btn-search {
    display: flex;

    justify-content: center;
    align-items: center;
    padding: 0 1rem 0 1rem;
    border-radius: 25px;
  }
  .btn-search i {
    margin-right: 1rem;
  }
  .search-inp {
    border-radius: 25px;
  }
  .search-inp {
    font-size: 0.8rem;
    width: 20rem;
    padding: 1rem 1rem 1rem 1rem;
  }
  .boxy {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"
      ><i class="fa-brands fa-files-pinwheel"></i
    ></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" href="/listings">Explore</a>
        </li>
      </ul>
      <div class="nav-item ms-auto boxy">
        <form class="d-flex" role="search" action="/listings/search">
          <input
            class="form-control me-2 search-inp"
            type="search"
            placeholder="Search By Destination ,country,hotel name "
            aria-label="Search"
            id="src"
            name="query"
          />
          <button class="btn btn-search" type="submit" id="search">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      </div>
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="/listings/new"> <i class="fa-solid fa-hotel" style="color: rgb(255, 212, 59); font-size: 20px;"></i> &nbsp; Airbnb your home </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/listings/mybookings"> <i class="fa-solid fa-receipt" style="color: rgb(99, 230, 190);font-size: 20px;"></i>Show my Bookings </a>
        </li>
         <li class="nav-item">
          <a class="nav-link" href="/listings/showMyFavorate"> <i class="fa-solid fa-star" style="color: rgb(208, 30, 30);"></i>My Favorate </a>
        </li>
        <% if (!currUser) { %>
        <li class="nav-item">
          <a class="nav-link" href="/signup"
            ><b>Signup </b><i class="fa-solid fa-user-plus"></i>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/login"><b>Login</b></a>
        </li>
        <% } %>

        <% if (currUser) { %>
        <li class="nav-item">
          <i><%= %></i>
          <a class="nav-link" href="/logout"
            >Logout <i class="fa-solid fa-right-from-bracket"></i
          ></a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
